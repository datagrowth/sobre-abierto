{
  "name": "@sobre-abierto/server",
  "version": "1.0.0",
  "private": true,
  "description": "Servidor de Sobre Abierto: API, login, proxy al dashboard de Hermes, cola de IA, dominios y motor de la Biblioteca de Conocimiento",
  "license": "AGPL-3.0-or-later",
  "author": "Datagrowth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/datagrowth/sobre-abierto.git",
    "directory": "apps/server"
  },
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "e2e:datos": "tsx scripts/respuestasE2E.ts",
    "docs:mcp": "tsx scripts/generarDocsMcp.ts",
    "demo:base": "tsx scripts/baseDemo.ts",
    "banco:respuestas": "tsx scripts/bancoRespuestas.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@modelcontextprotocol/server": "^2.2.0",
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.10.0",
    "busboy": "^1.6.0",
    "chokidar": "^5.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "docx": "^9.14.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.11.2",
    "fflate": "^0.8.3",
    "gray-matter": "^4.0.3",
    "httpxy": "^0.5.6",
    "nodemailer": "10.2.1",
    "pdf-lib": "1.17.1",
    "socket.io": "^4.7.5",
    "unpdf": "^1.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/busboy": "^1.5.5",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.5",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22"
  }
}
