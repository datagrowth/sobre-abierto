# Sobre Abierto en DESARROLLO LOCAL (npm run dev:server): copia a .env en la raíz.
# Para instalar con Docker no es esta: ver .env.example (lo genera install.sh).

APP_PORT=3110

# ─── Conexión a Hermes ────────────────────────────────────────────
# URL del dashboard de Hermes Agent.
HERMES_BASE_URL=http://localhost:9119

# Token de sesión inicial (opcional): se lee solo del HTML del dashboard.
HERMES_TOKEN=

# Basic auth del dashboard de Hermes (las mismas variables que su compose).
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=

# Raíz de datos de Hermes. Por defecto ~/.hermes.
# HERMES_HOME=/opt/data
# Rutas sueltas que sustituyen a la de HERMES_HOME (opcionales)
# HERMES_STATE_DB=/opt/data/state.db
# HERMES_SESSIONS_DIR=/opt/data/sessions

# ─── Acceso al monitor ────────────────────────────────────────────
# Usuario y contraseña de la pantalla de login del monitor. Vacías = abierto.
MONITOR_BASIC_AUTH_USERNAME=
MONITOR_BASIC_AUTH_PASSWORD=

# Interfaz de escucha. Vacío = '::'.
# HOST=0.0.0.0

# Intervalo de polling a la API de Hermes (ms)
HERMES_POLL_MS=5000

# Orígenes extra admitidos (CORS y comprobación de Origin), separados por comas. * = ninguno:
# la web y la API comparten origen (también con el proxy de Vite en desarrollo).
FRONTEND_URL=

# ─── Datos locales ────────────────────────────────────────────────
# Carpeta de la Biblioteca (notas y documentos) y bases de datos de la plataforma.
# VAULT_PATH=./vault
# PLATAFORMA_DATA_DIR=./.plataforma
# LibreOffice (opcional): lee los .doc y pagina las memorias. Se busca solo en la ruta de
# Debian, en el PATH y en la instalación típica de Windows; con otra ruta, indícala aquí.
# LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.exe
# LIBREOFFICE_ACTIVO=1
# CONVERSIONES_DIR=./.plataforma/conversiones
# OCR de los PDF escaneados (tesseract con español y pdftoppm en el PATH; si no, sus rutas).
# OCR_ACTIVO=1
# TESSERACT_BIN=C:\Program Files\Tesseract-OCR\tesseract.exe
# PDFTOPPM_BIN=pdftoppm

# ─── Radares ──────────────────────────────────────────────────────
# En local suele bastar con la web y lo guardado: 0 apaga la ingesta del radar.
# LICITACIONES_ACTIVO=0
# Perfiles de Hermes para la IA (API de runs). Vacíos = la IA espera.
# HERMES_LICITACIONES_URL=http://localhost:8642/p/licitaciones
# HERMES_LICITACIONES_KEY=
# HERMES_OFERTA_LICITACIONES_URL=http://localhost:8642/p/oferta-licitaciones
# HERMES_OFERTA_LICITACIONES_KEY=
# El resto de variables (frecuencias, lotes, carpetas…) y sus valores por defecto están en
# .env.example.
