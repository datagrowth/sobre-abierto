# Variables de Sobre Abierto para el docker-compose.yml de la raíz.
# `bash install.sh` crea el .env desde este archivo y genera las claves: no hace falta tocarlo a
# mano. Si lo copias tú (cp .env.example .env), rellena las que no están comentadas y no tienen
# valor (claves con `openssl rand -hex 32`). Lo comentado es opcional y lleva su valor por defecto.
# Un test comprueba que este archivo y el Compose tienen las mismas variables (apps/server/tests/infra.test.ts).
# El .env lleva claves: no lo subas a ningún repositorio (ya está en .gitignore).

# ─── La instalación ───────────────────────────────────────────────
# Versión de las imágenes de Sobre Abierto (la de una release, p. ej. 0.1.0, o latest). Para
# actualizar: cambia esto, `docker compose pull` y `docker compose up -d`.
# SOBRE_ABIERTO_VERSION=latest
# Dominio con HTTPS automático (override de Caddy, apunta a este servidor y deja libres 80 y 443):
# DOMINIO=licitaciones.example.com
# Dónde escucha el monitor en esta máquina. 127.0.0.1 = solo local (detrás de Caddy o un túnel);
# 0.0.0.0 abre el puerto a la red sin HTTPS: no lo hagas en Internet.
# MONITOR_BIND=127.0.0.1
# MONITOR_PUERTO=3110

# ─── Hermes ───────────────────────────────────────────────────────
HERMES_DASHBOARD=1
# Usuario y contraseña del dashboard de Hermes (solo de Hermes: el monitor tiene las
# suyas, abajo). Obligatorias: sin ellas el despliegue falla. Hermes las ve en su entorno.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=
# Secreto con el que Hermes firma sus sesiones: openssl rand -hex 32 (install.sh lo genera solo).
HERMES_DASHBOARD_BASIC_AUTH_SECRET=
# API de Hermes (la usa el monitor para lanzar los trabajos de IA de cada perfil).
API_SERVER_ENABLED=true
API_SERVER_HOST=0.0.0.0
# Obligatoria (sin ella el despliegue falla): openssl rand -hex 32
API_SERVER_KEY=
# HERMES_IMAGE_TAG=v2026.9.24

# ─── Agentes (un perfil de Hermes por dominio) ───────────────────
# La KEY es la API_SERVER_KEY del .env de cada perfil (/opt/data/profiles/<perfil>/.env).
# Vacías = la IA de ese dominio espera; el radar funciona igual.
HERMES_LICITACIONES_URL=http://hermes:8642/p/licitaciones
HERMES_LICITACIONES_KEY=
# Opcional: perfil «oferta-licitaciones» con un modelo mejor para guion, memoria, anexos y evaluación
# HERMES_OFERTA_LICITACIONES_URL=http://hermes:8642/p/oferta-licitaciones
# HERMES_OFERTA_LICITACIONES_KEY=
# Opcional: perfil «critico-licitaciones» con OTRO modelo para el crítico ciego de la memoria técnica
# (sin él critica el de oferta, el mismo que redacta, y la web avisa de que tiende a sobrevalorar)
# HERMES_OFERTA_CRITICO_URL=http://hermes:8642/p/critico-licitaciones
# HERMES_OFERTA_CRITICO_KEY=
# Token de Claude Code para el MCP de la plataforma (32 caracteres aleatorios o más).
AGENTE_TOKEN_CLAUDE_CODE=
# Trabajos de IA a la vez (1-8; 2 si no se pone): más rápido, pero gasta antes el cupo del
# modelo y la memoria de Hermes. Con 5, rehaciendo fichas, el uso del modelo se agotó en
# una hora (una ficha gasta 0,4–1 M de tokens): 3 es un buen punto de partida.
HERMES_RUNS_A_LA_VEZ=3
# Llamadas a herramientas del MCP por minuto y agente (120 si no se pone): frena un agente en bucle.
AGENTES_PETICIONES_MINUTO=

# ─── Google Drive ─────────────────────────────────────────────────
# Cliente OAuth propio (ver docs/operacion.md → Google Drive).
GDRIVE_CLIENT_ID=
GDRIVE_CLIENT_SECRET=
# 1 = copia de seguridad diaria a Drive; 0 = sin copia (p. ej. si el VPS ya hace la suya).
GDRIVE_BACKUP=0
# GDRIVE_BACKUP_HOUR=4               # hora (de TZ) desde la que se hace la copia del día
# GDRIVE_BACKUP_PLATAFORMA=semanal   # diaria | semanal | no: bases de datos de la plataforma
# GDRIVE_BACKUP_KEEP_DAYS=30
# GDRIVE_SYNC_INTERVAL=60            # segundos entre sincronizaciones con Drive
# Nombres de las carpetas en Drive (dentro de la que eliges al conectar) y otras de más:
# DRIVE_CARPETA_CONOCIMIENTO=Conocimiento   # la Biblioteca → /opt/data/conocimiento
# DRIVE_CARPETA_SKILLS=Skills               # skills de Hermes de la empresa → /opt/data/skills/empresa
# DRIVE_CARPETA_SALIDAS=Salidas             # lo que genera Hermes → /opt/data/salidas
# DRIVE_SYNC_EXTRA=                         # «Nombre=/opt/data/ruta;…» para sincronizar otras
# TZ=Europe/Madrid

# ─── Licitaciones ─────────────────────────────────────────────────
# LICITACIONES_ACTIVO=1              # 0 apaga la ingesta (la web y las tools siguen leyendo)
# LICITACIONES_SYNC_MINUTES=15       # sincronización con la Plataforma de Contratación
# LICITACIONES_MAX_PAGINAS=10
# LICITACIONES_CRIBAS_DIA=2          # 0 = sin criba automática («Cribar ahora» sigue)
# LICITACIONES_LOTE_CRIBA=40
# LICITACIONES_FICHA_AUTO=1
# LICITACIONES_HISTORICO_DESDE=2018
# LICITACIONES_HISTORICO_TODO=0
# LICITACIONES_PRECIOS_MINIMO=20
# LICITACIONES_MARGEN_FIRMA_HORAS=2   # horas antes del plazo para firmar y presentar: no se pide a Hermes lo que acabaría dentro
# LICITACIONES_RUNS_OFERTA_DIA=40     # tope de runs automáticos por oferta en 24 h (5-500; lo pedido a mano sale igual)
# LICITACIONES_PROPUESTAS_DIA=3       # tope de propuestas de decisiones pedidas solas por oferta en 24 h (1-20)
# LICITACIONES_ACTAS_MERCADO_DIA=5    # actas de expedientes ajenos que lee Hermes en 24 h si el código no basta (0-50; 0 = solo código)
# LICITACIONES_MEMORIA_UMBRAL=0.9     # se ensambla cuando el crítico le da esta parte de los puntos…
# LICITACIONES_MEMORIA_RONDAS=3       # …o cuando se acaban estas rondas de reescritura (0-3)
# LICITACIONES_DEUC_XML=0             # 1: prepara el DEUC en XML para el servicio DEUC (solo tras comprobar a mano que lo importa)
# LICITACIONES_PRECIO_HORA=35         # opcional: la ficha enseña a la persona los euros de cada compromiso (horas × precio); nunca a los agentes
# LICITACIONES_CARPETA_RADAR=Licitaciones/Radar
# LICITACIONES_CARPETA_PRESENTADAS=Licitaciones/Presentadas

# ─── Avisos por email ─────────────────────────────────────────────
# El SMTP del correo de la empresa, desde una cuenta del dominio. Sin SMTP_HOST no sale ningún
# email (el resumen semanal y los avisos quedan apuntados como no enviados).
# SMTP_HOST=smtp.example.com
# SMTP_PUERTO=587                     # 587 con STARTTLS; 465 con SMTP_TLS=1
# SMTP_TLS=0
# SMTP_USUARIO=avisos@example.com
# SMTP_CONTRASENA=                    # la de esa cuenta (o su contraseña de aplicación)
# SMTP_REMITENTE=Sobre Abierto <avisos@example.com>

# ─── La instalación ───────────────────────────────────────────────
# APP_URL=https://licitaciones.example.com   # dirección pública: enlaces de los avisos y del calendario
# APP_SOURCE_URL=                     # código fuente (aviso de la AGPL); vacío = el repositorio público
# La marca (nombre, colores y logo) va en Ajustes › Marca; la empresa (nombre comercial y zona
# horaria), en Ajustes › Empresa; la escala de los rankings, en Ajustes › Fuentes y filtros.

# ─── Monitor ──────────────────────────────────────────────────────
# Login del monitor. Obligatorias: sin ellas el despliegue falla. Propias del monitor:
# Hermes no las recibe, así que un agente manipulado no puede leerlas de su entorno.
# Contraseña larga (20 caracteres o más) y DISTINTA de HERMES_DASHBOARD_BASIC_AUTH_PASSWORD. El usuario
# es el correo del primer admin; la contraseña es la inicial: la web pide cambiarla en el primer acceso y, en
# cuanto un admin tiene la suya, esta deja de entrar. Si se pierde el acceso, un comando dentro del contenedor
# del monitor pone una contraseña temporal (docs/operacion.md, «Usuarios y recuperación de acceso»).
MONITOR_BASIC_AUTH_USERNAME=
MONITOR_BASIC_AUTH_PASSWORD=
# Firma las sesiones del monitor; 32 caracteres o más (el monitor no arranca con menos).
# Genéralo con: openssl rand -hex 32. Cambiarlo cierra todas las sesiones abiertas.
MONITOR_SESSION_SECRET=
# Proxies delante del monitor cuyo X-Forwarded-For es fiable: 0 con el puerto directo, 1 con Caddy (el override ya lo pone).
MONITOR_PROXIES_DE_CONFIANZA=0
# MONITOR_USER=10000:10000           # no lo cambies: hermes-init fija el volumen a 10000:10000
# FRONTEND_URL=                      # vacío = sin CORS (web y API en el mismo origen); o URLs separadas por comas
# HERMES_VAULT_PATH=/opt/data/conocimiento
# SALIDAS_DIR=/opt/data/salidas
# LIBREOFFICE_ACTIVO=1               # 0 apaga LibreOffice (los .doc no se leen y las memorias salen sin PDF)
# OCR_ACTIVO=1                       # 0 apaga el OCR de los PDF escaneados al indexarlos (siguen «escaneados»)
